+  // Remove event and maybe invalidate related app record.
+  // `_events` is mutated from multiple threads (task executions land on the
+  // location-delegate/main thread via executeTask, while JS task-finish calls
+  // land on expo.modules.AsyncFunctionQueue) — unsynchronized NSMutableArray
+  // mutation corrupts the array and removeObject:'s isEqual: walk then traps
+  // (EXC_BREAKPOINT in __StringStorage.isEqualToString). Guard every
+  // _events/_eventsQueues access with one lock.
+  BOOL becameEmpty = NO;
+  @synchronized (_events) {
+    NSMutableArray *appEvents = _events[appId];
+
+    if (appEvents) {
+      [appEvents removeObject:eventId];
+
+      if (appEvents.count == 0) {
+        [self->_events removeObjectForKey:appId];
+        becameEmpty = YES;
+      }
     }
   }
+  if (becameEmpty) {
+    // Invalidate app record but after 1 seconds delay so we can still take batched events.
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+      BOOL stillEmpty;
+      @synchronized (self->_events) {
+        stillEmpty = self->_events[appId] == nil;
+      }
+      if (stillEmpty) {
+        [self _invalidateAppWithId:appId];
+      }
+    });
+  }
 }
 
