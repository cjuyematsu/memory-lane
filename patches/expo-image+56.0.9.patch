+// PastPic patch: the best locally-available rendition of an asset, without
+// touching the network — the fallback when downloading the original failed
+// (full disk / offline). "Optimize iPhone Storage" keeps a device-sized version
+// of most assets, and every asset has at least a thumbnail in the local library
+// database, so this almost always yields something — the same image Apple
+// Photos shows in that state. Opportunistic (not .highQualityFormat, which can
+// return nil for offloaded assets when network is off): take the FIRST non-nil
+// delivery — for a local-only request that's the largest rendition on device —
+// and treat a nil FINAL delivery as "nothing local at all".
+private func requestBestLocalImage(
+  _ asset: PHAsset,
+  targetSize: CGSize,
+  completion: @escaping (UIImage?) -> Void
+) {
+  let options = PHImageRequestOptions()
+  options.isSynchronous = false
+  options.version = .current
+  options.deliveryMode = .opportunistic
+  options.resizeMode = .exact
+  options.normalizedCropRect = .zero
+  options.isNetworkAccessAllowed = false
+
+  var done = false
+  PHImageManager.default().requestImage(
+    for: asset,
+    targetSize: targetSize,
+    contentMode: .aspectFit,
+    options: options,
+    resultHandler: { image, info in
+      // PHImageManager invokes result handlers serially, so the flag is safe.
+      if done {
+        return
+      }
+      let isDegraded: Bool = info?[PHImageResultIsDegradedKey] as? Bool ?? false
+      if let image {
+        done = true
+        completion(image)
+      } else if !isDegraded {
+        done = true
+        completion(nil)
+      }
     }
   )
 }
 
+// A shared Core Image context for blurring placeholders, created once and reused.
+private let placeholderBlurContext = CIContext(options: [.useSoftwareRenderer: false])
+
+// PastPic patch: blur a low-resolution placeholder so it reads as a soft,
+// intentional preview rather than a blocky/pixelated upscale. The radius scales
+// with the image so it looks consistent regardless of the placeholder's size.
+// Any failure falls back to the original image (no blur), never to nil.
+private func blurredPlaceholder(_ image: UIImage) -> UIImage {
+  guard let cgImage = image.cgImage,
+    let filter = CIFilter(name: "CIGaussianBlur") else {
+    return image
+  }
+  let ciImage = CIImage(cgImage: cgImage)
+  // Clamp before blurring so the edges don't fade to transparent, then crop back
+  // to the original extent.
+  filter.setValue(ciImage.clampedToExtent(), forKey: kCIInputImageKey)
+  let minDimension = min(ciImage.extent.width, ciImage.extent.height)
+  filter.setValue(max(2.0, minDimension * 0.02), forKey: kCIInputRadiusKey)
+  guard let output = filter.outputImage,
+    let blurred = placeholderBlurContext.createCGImage(output, from: ciImage.extent) else {
+    return image
+  }
+  return UIImage(cgImage: blurred, scale: image.scale, orientation: image.imageOrientation)
+}
